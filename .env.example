# ==============================================================================
# Receivables Platform - Environment Configuration Example
# Copy to .env for local development
# NEVER COMMIT PRODUCTION SECRETS
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# Base URLs
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001

# PostgreSQL Database
DATABASE_URL=postgresql://receivables:receivables_secret@localhost:5432/receivables_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / Object Storage (S3 Compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=receivables_minio_admin
S3_SECRET_KEY=receivables_minio_secret
S3_BUCKET_NAME=receivables-documents
S3_FORCE_PATH_STYLE=true

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_replace_in_production_min_32_characters
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=refresh_secret_replace_in_production_min_32_characters
REFRESH_TOKEN_EXPIRES_IN=30d
INVITATION_TOKEN_EXPIRES_HOURS=72

# Business Defaults
DEFAULT_CURRENCY=RWF
DEFAULT_TIMEZONE=Africa/Kigali
DEFAULT_LOCALE=en-RW

# Observability & Logging
LOG_LEVEL=debug
OTEL_ENABLED=false
OTEL_SERVICE_NAME=receivables-api
